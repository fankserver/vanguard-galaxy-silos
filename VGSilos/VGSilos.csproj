<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>VGSilos</AssemblyName>
    <Product>Silos</Product>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>VGSilos</RootNamespace>
    <!-- Release-blocker fix: game 0.8.1 removed Newtonsoft.Json.dll from
         Managed/ (confirmed) — other mods merely happen to carry copies.
         VGSilos must be standalone, so Newtonsoft ships in our deploy output
         (the sidecar/import codec needs it live). The compile-only assets on
         everything else below stay strict: the package tests assert our
         output DLL set is exactly {VGSilos.dll, Newtonsoft.Json.dll}, so a
         stray BepInEx/Harmony/Unity copy fails the build gate. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" IncludeAssets="compile" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" IncludeAssets="compile" />
    <PackageReference Include="UnityEngine.Modules" Version="6000.2.6" IncludeAssets="compile" />
    <!-- Pinned to 2.10.x: BepInEx 5 ships HarmonyX 2.10, and 2.16+ adds a
         transitive MonoMod.Backports dep that BepInEx 5 doesn't load at
         runtime. See VGEcho.csproj for the full rationale. -->
    <PackageReference Include="HarmonyX" Version="2.10.*" IncludeAssets="compile" />
    <!-- Newtonsoft.Json: sidecar/import JSON persistence. SHIPS with the
         plugin (game 0.8.1 Managed/ no longer provides it — see the
         CopyLocalLockFileAssemblies note above); deployed beside VGSilos.dll
         by `make deploy`. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" IncludeAssets="compile;runtime" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>lib/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>lib/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>lib/Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- VGModAPI contract assembly: compile-time only. The game's BepInEx
         plugins folder ships VGModAPI.dll (which carries the abstractions),
         and the [BepInDependency] on vgmodapi enforces load order. Mirrors
         the VGMissionJournal pattern — symlinked by `make link-api`. -->
    <Reference Include="VGModAPI.Abstractions">
      <HintPath>lib/VGModAPI.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VGSilos.Tests" />
  </ItemGroup>

</Project>
